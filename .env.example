APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Paiement des abonnements : "simulation" (aucun débit, plan activé après quelques secondes) ou "live"
SUBSCRIPTION_PAYMENT_MODE=simulation

# API WhatsApp officielle (Meta) — voir Espace App > WhatsApp > Configuration
WHATSAPP_DRIVER=off
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_BUSINESS_ACCOUNT_ID=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_API_VERSION=v23.0

# Paiements : agrégateur actif (mercypay | pawapay | hrskills). Frais et commissions dans config/payments.php
# mercypay en production · test en local : paiements simulés, aucun argent ne circule (refusé en production)
PAYMENT_DRIVER=mercypay
PAWAPAY_ENV=sandbox
PAWAPAY_API_TOKEN=
MERCYPAY_API_KEY=
MERCYPAY_WEBHOOK_SECRET=
# direct : le client paie sans quitter Biolinko (demande sur son téléphone) · hosted : page Mercy Pay
MERCYPAY_CHECKOUT=direct

# Google Search Console : valeur « content » de la balise de validation
GOOGLE_SITE_VERIFICATION=

# Informations publiques (config/biolinko.php) : une valeur vide n’est pas affichée sur le site
BIOLINKO_CONTACT_EMAIL=contact@biolinko.app
BIOLINKO_WHATSAPP=
BIOLINKO_CITY="Douala, Cameroun"

# Domaine des boutiques : chaque boutique répond sur <nom>.<domaine> (ex. biolinko.store).
# Laisser vide en local : les boutiques restent sur APP_URL/<nom>.
# En production : DNS *.biolinko.store et certificat SSL générique (wildcard) requis.
BIOLINKO_STORE_DOMAIN=
BIOLINKO_SOCIAL_WHATSAPP=
BIOLINKO_SOCIAL_INSTAGRAM=
BIOLINKO_SOCIAL_TIKTOK=
BIOLINKO_SOCIAL_FACEBOOK=
BIOLINKO_SOCIAL_LINKEDIN=
BIOLINKO_SOCIAL_YOUTUBE=
# Mentions légales : à compléter une fois le statut juridique obtenu
BIOLINKO_PUBLISHER_NAME=
BIOLINKO_PUBLISHER_STATUS=
BIOLINKO_PUBLISHER_REGISTRATION=
BIOLINKO_PUBLISHER_ADDRESS=
BIOLINKO_PUBLISHER_DIRECTOR=
BIOLINKO_HOST_NAME=
BIOLINKO_HOST_ADDRESS=
