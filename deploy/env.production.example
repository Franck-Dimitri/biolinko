# ============================================================
# .env de PRODUCTION — biolinko.link
# Copier vers /var/www/biolinko/shared/.env sur le serveur, puis remplir les valeurs <...>.
# Ne JAMAIS committer le vrai fichier.
# ============================================================

APP_NAME=Biolinko
APP_ENV=production
APP_KEY=                       # généré par : php artisan key:generate --show
APP_DEBUG=false                # OBLIGATOIRE : true afficherait les secrets en cas d'erreur
APP_URL=https://biolinko.link
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

BCRYPT_ROUNDS=12

# Journaux : un fichier par jour, gardé 14 jours
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# Base de données MySQL (pas SQLite en production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=biolinko
DB_USERNAME=biolinko
DB_PASSWORD=<mot de passe long et aléatoire>

# Sessions sécurisées
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=biolinko.link

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# E-mails : fournisseur SMTP (Brevo, Mailgun, Resend…). Configurer SPF + DKIM sur le domaine.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<smtp.fournisseur.com>
MAIL_PORT=587
MAIL_USERNAME=<identifiant SMTP>
MAIL_PASSWORD=<mot de passe SMTP>
MAIL_FROM_ADDRESS=contact@biolinko.link
MAIL_FROM_NAME="Biolinko"

VITE_APP_NAME="${APP_NAME}"

# Abonnements : paiement réel
SUBSCRIPTION_PAYMENT_MODE=live

# Paiements : Mercy Pay en LIVE
PAYMENT_DRIVER=mercypay
MERCYPAY_API_KEY=<mp_live_...>
MERCYPAY_WEBHOOK_SECRET=<secret du webhook Mercy Pay>
# pawaPay (secours, désactivé tant que non utilisé)
PAWAPAY_ENV=production
PAWAPAY_API_TOKEN=

# WhatsApp officiel (Meta) — laisser vide tant que la vérification Meta n'est pas faite
WHATSAPP_DRIVER=cloud
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_BUSINESS_ACCOUNT_ID=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_API_VERSION=v21.0

# Google Search Console
GOOGLE_SITE_VERIFICATION=

# Sauvegardes (utilisé par deploy/scripts/backup.sh)
BACKUP_DIR=/var/backups/biolinko
BACKUP_KEEP_DAYS=14
